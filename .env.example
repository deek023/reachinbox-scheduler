# ==============================================================================
# ReachInbox Email Scheduler - Environment Configuration
# ==============================================================================

# Application Port & Base URL
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 1. PostgreSQL Database Configuration
DATABASE_URL="postgres://postgres:postgres@localhost:5432/reachinbox"
# Or individual parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=reachinbox

# 2. Redis Configuration (BullMQ Queue & Atomic Rate Limits)
REDIS_URL="redis://localhost:6379"

# 3. Worker Concurrency & Rate Limiting (Configurable)
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200

# 4. Elasticsearch Configuration (Full-Text Search Engine)
ELASTICSEARCH_URL="http://localhost:9200"

# 5. Session Security
SESSION_SECRET="reachinbox_super_secret_session_key_38741"

# 6. Real Google OAuth 2.0 Credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# 7. Real Slack OAuth & Webhook Integration
# Create at https://api.slack.com/apps
# Scopes: incoming-webhook, chat:write
# Redirect URL: http://localhost:3000/api/slack/callback
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:3000/api/slack/callback"

# 8. Ethereal SMTP Mailer (Leave empty to auto-generate test account)
ETHEREAL_USER=""
ETHEREAL_PASS=""

# Gemini API (system environment)
GEMINI_API_KEY=""
